---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');
const base = import.meta.env.BASE_URL;

const byCategory = CATEGORIES.map(({ slug, label, emoji, color }) => ({
	slug,
	label,
	emoji,
	color,
	posts: posts.filter((p) => p.data.category === slug).sort((a, b) => a.data.number - b.data.number),
}));
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`블로그 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
			}
			.category {
				margin-bottom: 2.5rem;
			}
			.category h2 {
				display: flex;
				align-items: center;
				gap: 0.4em;
				margin-bottom: 0.9rem;
			}
			.category h2 .dot {
				display: inline-block;
				width: 0.6em;
				height: 0.6em;
				border-radius: 50%;
				background: var(--cat-color, var(--accent));
			}
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.4em;
			}
			li a,
			li .draft {
				display: flex;
				align-items: baseline;
				gap: 0.75em;
				padding: 0.75em 0.9em;
				text-decoration: none;
				color: rgb(var(--ink));
				border-radius: var(--radius-sm);
				border: 1px solid transparent;
			}
			li a {
				background: rgb(var(--bg-alt));
				border-color: rgb(var(--border));
				transition: transform 0.12s ease, box-shadow 0.12s ease, border-color 0.12s ease;
			}
			li a:hover {
				transform: translateY(-1px);
				box-shadow: var(--shadow-sm);
				border-color: var(--cat-color, var(--accent));
			}
			li a:hover .title {
				color: var(--accent-ink);
			}
			.num {
				flex: none;
				width: 1.6em;
				color: var(--cat-color, rgb(var(--gray)));
				font-weight: 700;
				font-variant-numeric: tabular-nums;
			}
			.title {
				flex: 1;
			}
			.date {
				flex: none;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.draft {
				color: rgb(var(--gray));
				border-color: rgb(var(--border));
			}
			.draft .num {
				color: rgb(var(--gray));
			}
			.draft .title {
				font-style: italic;
			}
			.badge {
				flex: none;
				font-size: 0.75em;
				color: rgb(var(--gray));
				border: 1px solid rgb(var(--border));
				border-radius: 999px;
				padding: 0.2em 0.7em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>블로그</h1>
			{
				byCategory.map(({ label, emoji, color, posts: categoryPosts }) => (
					<section class="category" style={`--cat-color: ${color}`}>
						<h2>
							<span class="dot" />
							{emoji} {label}
						</h2>
						<ul>
							{categoryPosts.map((post) => (
								<li>
									{post.data.draft ? (
										<span class="draft">
											<span class="num">{post.data.number}</span>
											<span class="title">{post.data.title}</span>
											<span class="badge">준비중</span>
										</span>
									) : (
										<a href={`${base}blog/${post.id}/`}>
											<span class="num">{post.data.number}</span>
											<span class="title">{post.data.title}</span>
											{post.data.pubDate && (
												<span class="date">
													<FormattedDate date={post.data.pubDate} />
												</span>
											)}
										</a>
									)}
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
