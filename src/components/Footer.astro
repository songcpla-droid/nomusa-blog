---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} {SITE_TITLE}</p>
</footer>
<style>
	footer {
		margin-top: 2em;
		padding: 2.5em 1em 5em 1em;
		background: rgb(var(--bg-alt));
		border-top: 1px solid rgb(var(--border));
		color: rgb(var(--gray));
		text-align: center;
	}
	footer p {
		margin: 0;
		font-size: 0.9em;
	}
</style>
