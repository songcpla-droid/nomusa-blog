---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const base = import.meta.env.BASE_URL;
---

<header>
	<nav>
		<h2><a href={base}>✍️ {SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href={base}>홈</HeaderLink>
			<HeaderLink href={`${base}blog/`}>블로그</HeaderLink>
			<HeaderLink href={`${base}about/`}>소개</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1em;
		background: rgba(var(--bg), 0.85);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid rgb(var(--border));
	}
	h2 {
		margin: 0;
		font-size: 1.05em;
	}
	h2 a {
		text-decoration: none;
		color: rgb(var(--ink));
		font-weight: 800;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 720px;
		margin: 0 auto;
	}
	nav a {
		display: inline-block;
		padding: 0.5em 0.9em;
		margin: 0.2em;
		color: rgb(var(--ink-soft, var(--ink)));
		border-radius: 999px;
		text-decoration: none;
		font-weight: 600;
		transition: background-color 0.15s ease, color 0.15s ease;
	}
	nav a:hover {
		background: var(--accent-soft);
		color: var(--accent-ink);
	}
	nav a.active {
		background: var(--accent-soft);
		color: var(--accent-ink);
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
</style>
