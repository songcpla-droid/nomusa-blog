---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { categoryInfo } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category } = Astro.props;
const base = import.meta.env.BASE_URL;
const cat = category ? categoryInfo(category) : undefined;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: var(--radius);
				box-shadow: var(--shadow-md);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2em 1em;
				color: rgb(var(--ink));
			}
			.back-link {
				display: inline-block;
				margin-bottom: 1.5em;
				font-weight: 600;
				text-decoration: none;
			}
			.title {
				margin-bottom: 1.5em;
				padding-bottom: 1.5em;
				border-bottom: 1px solid rgb(var(--border));
			}
			.category-badge {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				padding: 0.3em 0.9em;
				border-radius: 999px;
				background: var(--accent-soft);
				color: var(--cat-color, var(--accent-ink));
				font-size: 0.85em;
				font-weight: 700;
				margin-bottom: 0.8em;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				color: rgb(var(--gray));
				font-size: 0.95em;
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<a class="back-link" href={`${base}blog/`}>← 목록으로</a>
					<div class="title" style={cat ? `--cat-color: ${cat.color}` : undefined}>
						{
							cat && (
								<p class="category-badge">
									{cat.emoji} {cat.label}
								</p>
							)
						}
						<h1>{title}</h1>
						<div class="date">
							{pubDate && <FormattedDate date={pubDate} />}
							{
								updatedDate && (
									<div class="last-updated-on">
										최종 수정일: <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
